---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません | secure-auto-lab FXラボ" description="お探しのページは見つかりませんでした。">
  <main class="mx-auto max-w-[720px] px-5">
    <section class="my-16 rounded-2xl border border-hairline bg-surface px-6 py-16 text-center">
      <h1 class="font-serif-jp text-3xl font-semibold">404</h1>
      <p class="mt-4 text-ink-secondary">お探しのページは見つかりませんでした。</p>
      <p class="mt-6">
        <a href="/" class="text-accent hover:underline">トップに戻る</a>
      </p>
    </section>
  </main>
</BaseLayout>
