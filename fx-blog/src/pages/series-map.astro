---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const publishedByIndex = new Map(posts.map((post) => [post.data.seriesIndex, post]));

const nodes = [
  {
    index: '0',
    title: '口座が消えた日',
    badge: 'free',
    description: '5回の全損と「またか」。AIに明細を渡すまでの話',
    seriesIndex: 0,
  },
  {
    index: '1',
    title: '敗因の解剖',
    badge: 'paid',
    description: '取引明細×実レートで見る「99%勝てるのに破産する」構造',
    seriesIndex: 1,
  },
  {
    index: '2',
    title: '手法の墓場',
    badge: 'paid',
    description: 'ナンピン・逆張り・ドテン…検証で棄却した戦略たちと、棄却できる物差しの作り方',
    seriesIndex: 2,
  },
  {
    index: '3',
    title: 'コストの真実',
    badge: 'paid',
    description: '広告スプレッドは実測の2.6〜3.8倍嘘をつく。自作ロガーによる業者実測比較',
    seriesIndex: 3,
  },
  {
    index: '4',
    title: '生き残った一つ',
    badge: 'paid',
    description: '15年・4万トレードの検証を耐えたシンプルな仕組みと、過学習との戦い',
    seriesIndex: 4,
  },
  {
    index: '5',
    title: '実弾前夜',
    badge: 'paid',
    description: 'EA実装・撤退基準・運用ルールブック。「負け方」を先に決める',
    seriesIndex: 5,
  },
  {
    index: '∞',
    title: 'リアルタイム運用記',
    badge: 'auto',
    description: '実口座の成績を、良くても悪くても改変せず公開する週次・日次の記録',
    seriesIndex: 6,
  },
];
---

<BaseLayout
  title="連載マップ | secure-auto-lab FXラボ"
  description="連載「全損から始める自動売買」の全体マップ。全損の記録から始まり、検証で棄却を積み上げ、生き残った一つを実運用に載せるまで。"
>
  <main class="mx-auto max-w-[720px] px-5">
    <section class="my-10 rounded-2xl border border-hairline bg-surface px-6 py-10 sm:px-10">
      <h1 class="font-serif-jp text-2xl font-semibold tracking-wide">連載の全体マップ</h1>
      <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
        全損の記録から始まり、検証で棄却を積み上げ、生き残った一つを実運用に載せるまで
      </p>

      <ol class="relative mt-8 ml-2.5">
        <div class="absolute bottom-16 left-[17px] top-6 w-0.5 bg-grid" aria-hidden="true"></div>
        {
          nodes.map((node) => {
            const post = publishedByIndex.get(node.seriesIndex);
            return (
              <li class="relative flex items-start gap-4 py-2.5">
                <span
                  class:list={[
                    'z-10 flex h-9 w-9 flex-none items-center justify-center rounded-full text-[15px] font-bold',
                    node.index === '0'
                      ? 'bg-accent text-white'
                      : node.badge === 'auto'
                        ? 'border-[2.5px] border-dashed border-accent-blue bg-surface text-accent-blue'
                        : 'border-[2.5px] border-accent bg-surface text-accent',
                  ]}
                >
                  {node.index}
                </span>
                <div class="pt-0.5">
                  <p class="text-lg font-bold leading-snug">
                    {post ? (
                      <a href={`/posts/${post.id}/`} class="hover:text-accent">
                        {node.title}
                      </a>
                    ) : (
                      node.title
                    )}
                    {node.badge === 'free' && (
                      <span class="ml-2.5 inline-block rounded-full bg-accent px-2.5 py-0.5 align-[2px] text-xs font-semibold text-white">
                        無料公開
                      </span>
                    )}
                    {node.badge === 'paid' && (
                      <span class="ml-2.5 inline-block rounded-full border border-axis px-2.5 py-0.5 align-[2px] text-xs font-semibold text-ink-secondary">
                        有料
                      </span>
                    )}
                    {node.badge === 'auto' && (
                      <span class="ml-2.5 inline-block rounded-full border border-accent-blue px-2.5 py-0.5 align-[2px] text-xs font-semibold text-accent-blue">
                        連載（自動生成＋人の承認）
                      </span>
                    )}
                    {!post && node.badge !== 'auto' && (
                      <span class="ml-2 text-xs font-normal text-muted">近日公開</span>
                    )}
                  </p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-secondary">{node.description}</p>
                </div>
              </li>
            );
          })
        }
      </ol>

      <p class="mt-6 text-xs text-muted">本連載は個人の記録・検証の共有であり、投資助言ではない。</p>
    </section>
  </main>
</BaseLayout>
