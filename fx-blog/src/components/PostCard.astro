---
import type { CollectionEntry } from 'astro:content';
import PaidBadge from './PaidBadge.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, seriesIndex, paid } = post.data;
const dateLabel = pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="rounded-2xl border border-hairline bg-surface p-6 transition-shadow hover:shadow-sm">
  <div class="flex items-center gap-3 text-xs text-muted">
    <span>第{seriesIndex}部</span>
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    <PaidBadge paid={paid} />
  </div>
  <h2 class="mt-3 font-serif-jp text-lg font-semibold leading-snug">
    <a href={`/posts/${post.id}/`} class="hover:text-accent">{title}</a>
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{description}</p>
</article>
